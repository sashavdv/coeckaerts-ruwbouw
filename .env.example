# Buildvariabelen (Astro). Lokaal: kopieer naar .env. In Cloudflare: Settings → Build → Variables and secrets.

# Zet op true voor de echte livegang. Zolang dit niet "true" is, krijgt elke pagina
# <meta name="robots" content="noindex">, zodat Google de preview niet oppikt.
PUBLIC_SITE_LIVE=false

# Site key van Cloudflare Turnstile (dashboard → Turnstile → widget voor de domeinen van deze site).
# Leeg = geen spamcontrole op het formulier.
PUBLIC_TURNSTILE_SITE_KEY=
