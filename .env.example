# Kopieer naar .env en vul in.

# Zet op true voor de echte livegang. Zolang dit niet "true" is, krijgt elke pagina
# <meta name="robots" content="noindex">, zodat Google de preview niet oppikt.
PUBLIC_SITE_LIVE=false

# Gratis sleutel van https://web3forms.com (aanvragen met Wards e-mailadres).
# Zonder sleutel opent het contactformulier het mailprogramma van de bezoeker.
PUBLIC_WEB3FORMS_KEY=
