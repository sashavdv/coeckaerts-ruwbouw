---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { SITE } from '../site';
import werf from '../assets/werf-bc-bouw.jpg';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Bouw- of verbouwplannen?',
  text = 'Vertel ons over uw project. Ward komt graag langs voor een vrijblijvend gesprek en maakt een duidelijke offerte op maat.',
} = Astro.props;
---

<section class="cta">
  <div class="container wrap" data-reveal>
    <div class="content">
      <p class="eyebrow">Vrijblijvende offerte</p>
      <h2>{title}</h2>
      <p class="text">{text}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/">Offerte aanvragen <Icon name="arrow" /></a>
        <a class="btn btn--light" href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
      </div>
    </div>
    <div class="media">
      <Image src={werf} alt="Werf van BC Bouw met bouwbord" widths={[400, 700]} sizes="(max-width: 900px) 100vw, 420px" />
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section);
  }

  .wrap {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: stretch;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-lg);
    background: var(--bordeaux);
    color: var(--white);
    box-shadow: var(--shadow-lg);
  }

  /* Huislijn uit het logo als decoratie */
  .wrap::before {
    content: '';
    position: absolute;
    left: -40px;
    bottom: -60px;
    width: 340px;
    height: 300px;
    border: 22px solid var(--rood);
    border-top: 0;
    border-right: 0;
    border-radius: 0 0 0 40px;
    opacity: 0.35;
    pointer-events: none;
  }

  .content {
    position: relative;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .eyebrow {
    color: #ffd2d2;
  }

  h2 {
    color: var(--white);
  }

  .text {
    max-width: 52ch;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 1.125rem;
  }

  .media {
    position: relative;
    min-height: 260px;
  }

  .media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .wrap {
      grid-template-columns: 1fr;
    }

    .media {
      order: -1;
      min-height: 220px;
    }
  }
</style>
