---
// Eenvoudige lijn-iconen (24×24, stroke = currentColor).
interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
  [key: string]: unknown;
}

const paths = {
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  pin: '<path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  facebook:
    '<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v7h4v-7h3l1-4h-4V8z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  quote:
    '<path d="M10 7H6a2 2 0 0 0-2 2v4h5v5H4M20 7h-4a2 2 0 0 0-2 2v4h5v5h-5"/>',
  // Diensten
  house:
    '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-5h4v5"/>',
  renovate:
    '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h8"/><path d="m14.5 19.5 5-5a1.4 1.4 0 0 0-2-2l-5 5-.7 2.7z"/>',
  bricks:
    '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9.3h18M3 14.6h18M9 4v5.3M15 4v5.3M6 9.3v5.3M12 9.3v5.3M18 9.3v5.3M9 14.6V20M15 14.6V20"/>',
  excavator:
    '<path d="M3 17h11v3H3z"/><path d="M5 17v-4h7l2 4"/><path d="m12 13 3-7 5 3-2 4"/><path d="M18 13l2 3h-4"/>',
  foundation:
    '<path d="M4 15h16v5H4z"/><path d="M7 15V8M12 15V5M17 15V8"/><path d="M4 11h16"/>',
  stairs:
    '<path d="M3 20h18"/><path d="M4 20v-4h4v-4h4V8h4V4h4"/>',
  // Werkwijze
  talk: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h8M8 13h5"/>',
  doc: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
  calendar:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="m11 12 8-8M16 7l2 2M14 9l2 2"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
} as const;

// `rest` geeft o.a. Astro's scoped-style attribuut door, zodat de oudercomponent het icoon kan stijlen.
const { name, size = 24, class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
