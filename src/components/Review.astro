---
import { SITE } from '../site';
---

<section class="section review">
  <div class="container inner" data-reveal>
    <span class="q" aria-hidden="true">“</span>
    <blockquote>
      <p>
        “Wij zijn zeer tevreden van onze keuze om Ward ons huis te laten bouwen. Moesten we het ooit opnieuw doen, we
        zouden niet twijfelen!”
      </p>
      <footer>
        <strong>Michaël en Ilse</strong>
        <span>Aanbeveling op <a href={SITE.facebook} target="_blank" rel="noopener">Facebook</a></span>
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .review {
    position: relative;
    overflow: hidden;
    background: var(--bg-warm);
  }

  .inner {
    max-width: 900px;
    text-align: center;
  }

  .q {
    display: block;
    height: 3.5rem;
    margin-bottom: 0.5rem;
    color: var(--rood);
    font-size: 7rem;
    font-weight: 800;
    line-height: 1;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    margin-bottom: 1.75rem;
    font-size: clamp(1.375rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--bordeaux);
    text-wrap: balance;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--ink-soft);
  }

  footer strong {
    color: var(--ink);
    font-size: 1.0625rem;
  }
</style>
