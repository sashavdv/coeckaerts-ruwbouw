---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import heroImg from '../assets/realisaties/woning-in-witte-gevelsteen/01.jpg';

// Het formulier post naar /api/contact (Cloudflare Worker, zie worker/index.ts) die via Resend mailt.
// Waar die API niet bestaat (GitHub Pages, lokale `astro dev`) of nog niet ingesteld is,
// opent het formulier het mailprogramma van de bezoeker met een ingevuld bericht.
// PUBLIC_TURNSTILE_SITE_KEY (buildvariabele) zet de spambescherming van Cloudflare Turnstile aan.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const types = [
  'Nieuwbouw (ruwbouw)',
  'Renovatie of verbouwing',
  'Aanbouw / uitbreiding',
  'Gevel- of metselwerk',
  'Afbraak of grondwerken',
  'Riolering of buitenwerk',
  'Iets anders',
];
---

<BaseLayout
  title="Contact & offerte"
  description={`Vraag vrijblijvend een offerte aan bij BC Bouw. Bel Ward op ${SITE.phone} of stuur een bericht via het contactformulier.`}
>
  <PageHero
    eyebrow="Contact"
    title="Vraag uw offerte aan"
    lead="Vertel ons kort over uw project. Ward neemt zo snel mogelijk contact met u op voor een vrijblijvend gesprek."
    image={heroImg}
    crumbs={[{ href: '/contact/', label: 'Contact' }]}
  />

  <section class="section">
    <div class="container layout">
      <div class="form-card">
        <h2>Stuur ons een bericht</h2>
        <p class="muted">Velden met een * zijn verplicht.</p>

        <form class="form" data-form data-endpoint={url('/api/contact')} novalidate>
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid2">
            <label class="field">
              <span>Naam *</span>
              <input name="naam" type="text" autocomplete="name" required />
            </label>
            <label class="field">
              <span>Telefoon *</span>
              <input name="telefoon" type="tel" autocomplete="tel" inputmode="tel" required />
            </label>
          </div>

          <div class="grid2">
            <label class="field">
              <span>E-mail *</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label class="field">
              <span>Gemeente van de werf</span>
              <input name="gemeente" type="text" autocomplete="address-level2" />
            </label>
          </div>

          <label class="field">
            <span>Type werk</span>
            <select name="type">
              <option value="">Maak een keuze</option>
              {types.map((t) => <option>{t}</option>)}
            </select>
          </label>

          <label class="field">
            <span>Uw project *</span>
            <textarea name="bericht" rows="6" required placeholder="Wat wilt u laten bouwen of verbouwen? Heeft u al plannen of een timing in gedachten?"></textarea>
          </label>

          <label class="consent">
            <input type="checkbox" name="toestemming" required />
            <span>Ik ga akkoord dat BC Bouw mijn gegevens gebruikt om mijn aanvraag te beantwoorden. Lees de <a href={url('/privacy/')}>privacyverklaring</a>. *</span>
          </label>

          {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-language="nl" data-theme="light" />}

          <button class="btn btn--primary submit" type="submit">Verstuur aanvraag <Icon name="arrow" /></button>
          <p class="status" data-status role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="info">
        <div class="info-card">
          <h2>Liever direct contact?</h2>
          <p>Bel of mail Ward rechtstreeks. Bent u niet meteen geholpen? Dan belt hij u zo snel mogelijk terug.</p>
          <ul class="contact-list">
            <li>
              <span class="ci"><Icon name="phone" /></span>
              <div>
                <small>Telefoon</small>
                <a href={SITE.phoneHref}>{SITE.phone}</a>
              </div>
            </li>
            <li>
              <span class="ci"><Icon name="mail" /></span>
              <div>
                <small>E-mail</small>
                <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
              </div>
            </li>
            <li>
              <span class="ci"><Icon name="pin" /></span>
              <div>
                <small>Werkgebied</small>
                <span>{SITE.region}</span>
              </div>
            </li>
            <li>
              <span class="ci"><Icon name="facebook" /></span>
              <div>
                <small>Facebook</small>
                <a href={SITE.facebook} target="_blank" rel="noopener">BC Bouw</a>
              </div>
            </li>
          </ul>
        </div>
        <div class="tip">
          <h3>Tip voor een snelle offerte</h3>
          <p>Heeft u al plannen van een architect, foto's van de huidige situatie of een stedenbouwkundige vergunning? Vermeld het gerust. Zo kunnen we sneller een correcte prijs geven.</p>
        </div>
      </aside>
    </div>
  </section>
  {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>

<script>
  import { SITE } from '../site';

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

  const setStatus = (text: string, kind: 'success' | 'error' | '' = '') => {
    status.className = kind ? `status is-${kind}` : 'status';
    status.textContent = text;
  };

  // Open het mailprogramma van de bezoeker met een ingevuld bericht.
  const openMailFallback = (data: FormData) => {
    const body = [
      `Naam: ${data.get('naam')}`,
      `Telefoon: ${data.get('telefoon')}`,
      `E-mail: ${data.get('email')}`,
      `Gemeente: ${data.get('gemeente') || '-'}`,
      `Type werk: ${data.get('type') || '-'}`,
      '',
      String(data.get('bericht')),
    ].join('\n');
    window.location.href = `mailto:${SITE.email}?subject=${encodeURIComponent('Aanvraag via de website')}&body=${encodeURIComponent(body)}`;
    setStatus('Uw mailprogramma wordt geopend. Verstuur daar het bericht.', 'success');
  };

  const resetTurnstile = () => (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = 'status';

    if (!form.checkValidity()) {
      form.classList.add('was-validated');
      const firstInvalid = form.querySelector<HTMLElement>(':invalid');
      firstInvalid?.focus();
      status.textContent = 'Vul de verplichte velden in.';
      status.classList.add('is-error');
      return;
    }

    const data = new FormData(form);
    if (data.get('botcheck')) return;

    button.disabled = true;
    setStatus('Bezig met verzenden…');

    let res: Response;
    try {
      res = await fetch(form.dataset.endpoint!, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
    } catch {
      // Geen verbinding met de API: val terug op het mailprogramma.
      button.disabled = false;
      openMailFallback(data);
      return;
    }

    const result = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
    button.disabled = false;

    if (res.ok && result?.ok) {
      form.reset();
      form.classList.remove('was-validated');
      resetTurnstile();
      setStatus('Bedankt! Uw aanvraag is verstuurd. Ward neemt zo snel mogelijk contact met u op.', 'success');
      return;
    }

    // Geen API op deze hosting (404/405) of nog niet ingesteld (503): mailprogramma als alternatief.
    if (!result || [404, 405, 503].includes(res.status)) {
      openMailFallback(data);
      return;
    }

    resetTurnstile();
    if (result.error === 'turnstile') {
      setStatus('De spamcontrole is mislukt. Probeer het opnieuw.', 'error');
    } else if (result.error === 'validation') {
      setStatus('Controleer de ingevulde gegevens en probeer opnieuw.', 'error');
    } else {
      setStatus(`Er ging iets mis bij het verzenden. Bel ons gerust op ${SITE.phone}.`, 'error');
    }
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .form-card {
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    margin-top: calc(-1 * clamp(3rem, 6vw, 5rem));
    position: relative;
    z-index: 2;
  }

  .form-card h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 0.25rem;
  }

  .muted {
    color: var(--ink-soft);
    font-size: 0.925rem;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field span {
    font-weight: 700;
    font-size: 0.925rem;
  }

  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  textarea {
    resize: vertical;
    min-height: 140px;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--bordeaux);
    box-shadow: 0 0 0 3px rgba(139, 40, 40, 0.15);
  }

  .was-validated :invalid {
    border-color: var(--rood);
  }

  .consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.925rem;
    color: var(--ink-soft);
  }

  .consent input {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 0.15rem;
    accent-color: var(--bordeaux);
  }

  .was-validated .consent input:invalid + span {
    color: var(--rood);
  }

  .submit {
    justify-self: start;
  }

  .status {
    margin: 0;
    font-weight: 600;
  }

  .status:empty {
    display: none;
  }

  .status.is-success {
    color: #1f7a3d;
  }

  .status.is-error {
    color: var(--rood);
  }

  .info {
    display: grid;
    gap: 1.5rem;
  }

  .info-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
    background: var(--bordeaux);
    color: var(--white);
  }

  .info-card h2 {
    font-size: 1.5rem;
    color: var(--white);
  }

  .info-card p {
    color: rgba(255, 255, 255, 0.85);
  }

  .contact-list {
    display: grid;
    gap: 1.1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }

  .ci {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
  }

  .contact-list small {
    display: block;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8125rem;
  }

  .contact-list a,
  .contact-list span {
    color: var(--white);
    font-weight: 700;
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }

  .tip {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--bg-warm);
    border-left: 5px solid var(--rood);
  }

  .tip h3 {
    font-size: 1.0625rem;
  }

  .tip p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid2 {
      grid-template-columns: 1fr;
    }

    .submit {
      width: 100%;
    }
  }
</style>
