---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProjects } from '../../lib/projects';
import heroImg from '../../assets/realisaties/nieuwbouw-in-rode-baksteen/03.jpg';

const projects = await getProjects();
const categories = ['Alles', ...new Set(projects.map((p) => p.data.category))];
---

<BaseLayout
  title="Realisaties"
  description="Bekijk realisaties van BC Bouw: nieuwbouwwoningen, verbouwingen, aanbouwen en gevelwerken met sierwerk en recuperatiesteen."
>
  <PageHero
    eyebrow="Realisaties"
    title="Ons werk spreekt voor zich"
    lead="Nieuwbouw, verbouwingen en gevelwerken. Een overzicht van projecten waar BC Bouw de ruwbouw verzorgde."
    image={heroImg}
    crumbs={[{ href: '/realisaties/', label: 'Realisaties' }]}
  />

  <section class="section">
    <div class="container">
      <div class="filters" role="group" aria-label="Filter op type project">
        {
          categories.map((c, i) => (
            <button type="button" class="filter" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c}>
              {c}
            </button>
          ))
        }
      </div>

      <div class="grid">
        {
          projects.map((p, i) => (
            <div class="item" data-category={p.data.category}>
              <ProjectCard project={p} eager={i < 3} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand title="Wordt uw project het volgende?" />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-category]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((it) => {
        it.hidden = f !== 'Alles' && it.dataset.category !== f;
      });
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .filter:hover {
    border-color: var(--bordeaux);
    color: var(--bordeaux);
  }

  .filter[aria-pressed='true'] {
    border-color: var(--bordeaux);
    background: var(--bordeaux);
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .item[hidden] {
    display: none;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
